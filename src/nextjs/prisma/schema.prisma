// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Recording {
  uuid String @id @default(uuid())
  id String  // for URL
  teamUuid String
  team Team @relation(fields:[teamUuid], references: [uuid])
  @@unique([id,teamUuid])
  title String  // for display

  uploadDate DateTime
  fileCreateDate DateTime
  blobUrl String

  referenceUuid String?
  reference Reference? @relation(fields: [referenceUuid],references: [uuid])

  // どのパイプラインバージョンで処理すべきか / 実際に処理し切ったか。
  // ステージ構成やモデルは変わりうるので、再処理の要否を判断できるように追跡する。
  targetPipelineVersion    String  // アップロード時に当時のCURRENT_PIPELINE_VERSIONをセット
  processedPipelineVersion String? // 全ステージ完了時にセット

  segment Segment[]
  job ProcessingJob?
}

/// Pythonワーカーが処理する録音1件ぶんのジョブ。
/// NextJSがアップロード時にPENDINGで作成し、ワーカーがポーリング(FOR UPDATE SKIP LOCKED)して処理する。
/// (src/README.md「各録音のパイプライン処理について」を参照)
model ProcessingJob {
  uuid String @id @default(uuid())

  recordingUuid String @unique
  recording Recording @relation(fields: [recordingUuid], references: [uuid], onDelete: Cascade)

  status JobStatus @default(PENDING)

  // このジョブ実行が採用したパイプラインバージョン(claim時に recording.targetPipelineVersion を採用)。
  pipelineVersion String
  // 直近に着手/完了したステージのID。ステージ構成はバージョンで変わりうるのでenumにはしない。
  stage String?
  // 各ステージの実行記録。どのステージをどのモデル/コードで処理したかを残す:
  // [{ "stage": "segmentation", "processor": "inaSpeechSegmenter", "version": "0.8.0",
  //    "status": "done", "startedAt": "...", "finishedAt": "...", "error": null }, ...]
  stageRuns Json?

  attempts    Int @default(0)
  maxAttempts Int @default(3)
  error       String? // 最後に失敗したときのメッセージ

  // ワーカー間の排他制御用。claim時にセットする。
  lockedBy String?   // ワーカーインスタンスの識別子
  lockedAt DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([status])
}

enum JobStatus {
  PENDING // 未着手
  RUNNING // ワーカーが処理中
  DONE    // 全ステージ完了
  FAILED  // maxAttemptsを使い切って失敗
}

model Segment {
  id Int
  recordingUuid String
  recording Recording @relation(fields: [recordingUuid], references: [uuid])
  @@id([id,recordingUuid])

  type SegType
  start Float // 秒
  end Float // 秒

  text String? //if type==SPEECH

  referenceUuid String?  //if type==MUSIC
  reference Reference? @relation(fields: [referenceUuid],references: [uuid])
  refStart Float?  // 秒
  refEnd Float?  // 秒

}
enum SegType {
  SPEECH
  MUSIC
}

model Reference {
  uuid String @id @default(uuid())
  teamUuid String
  team Team @relation(fields:[teamUuid], references: [uuid])

  title String

  blobUrl String

  status ReferenceStatus

  recordings Recording[]
  segments Segment[]
}
enum ReferenceStatus {
  ACTIVE
  ARCHIVED
}


model Team {
  uuid String @id @default(uuid())
  id String @unique
  name String
  recordings Recording[]
  references Reference[]

  users UserTeam[]
}
model User {
  uuid String @id @default(uuid())

  teams UserTeam[]
}

model UserTeam {
  teamUuid String
  team Team @relation(fields: [teamUuid],references: [uuid])
  userUuid String
  user User @relation(fields: [userUuid],references: [uuid])

  role UserTeamRole

  @@id([teamUuid,userUuid])
}

enum UserTeamRole {
  ADMIN
  WRITE
  READ
}

