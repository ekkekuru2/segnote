# ワーカー用の環境変数。`cp .env.example .env` して埋める。
# (NextJS 側の src/nextjs/.env と同じ DB / ストレージを指すこと)

# 接続先 PostgreSQL。Prisma と同じ DB を使う。
DATABASE_URL=postgres://user:password@host:5432/segnote-dev

# アップロードファイルの保存先。未指定なら src/storage を使う(NextJS 既定と同じ)。
# SEGNOTE_STORAGE_DIR=/abs/path/to/segnote/src/storage

# 同時処理ジョブ数
# SEGNOTE_WORKER_CONCURRENCY=2
# 処理待ちが無いときのポーリング間隔(秒)
# SEGNOTE_WORKER_POLL_INTERVAL=5
# RUNNING のまま放置されたジョブを戻すまでの猶予(秒)
# SEGNOTE_STALE_JOB_TIMEOUT=1800
# このワーカーの識別子(未指定なら hostname:pid)
# SEGNOTE_WORKER_ID=gpu-box-1
